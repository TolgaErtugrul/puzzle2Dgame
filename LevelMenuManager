        if(levelScrollView != null) levelScrollView.SetActive(false);
    
        // 2. Şimdi kayıtlı veriye göre karar ver
        int tutorialDone = PlayerPrefs.GetInt("TutorialCompleted", 0);
    
        if (tutorialDone == 1)
        {
            // Eski oyuncu: Giriş panelini atla, direkt listeyi göster
            if (startPanel != null) startPanel.SetActive(false);
            if (levelScrollView != null) levelScrollView.SetActive(true);
        }
        else
        {
            // Yeni oyuncu: Sadece Giriş Paneli aktif kalsın
            if (startPanel != null) startPanel.SetActive(true);
            if (levelScrollView != null) levelScrollView.SetActive(false);
        }
    }

    void Awake()
    {
        // Eğer sahnede başka bir manager varsa onu yok et, bu güncel olanı tut
        if (Instance != null && Instance != this)
        {
            Destroy(Instance.gameObject);
        }
        Instance = this;
    }

